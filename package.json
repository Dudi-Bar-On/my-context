{
  "name": "mycontext",
  "version": "1.0.2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src/",
    "commands/",
    "skills/",
    "hooks/",
    ".claude-plugin/",
    ".mcp.json"
  ],
  "bin": {
    "mycontext": "./src/cli/index.ts"
  },
  "scripts": {
    "test": "node --import ./test/helpers/pin-rendering.ts --test \"test/**/*.test.ts\"",
    "test:perf": "node --import ./test/helpers/pin-rendering.ts --test --test-concurrency=1 \"test/perf/*.perf.ts\"",
    "test:e2e": "node scripts/e2e-gate.ts",
    "test:e2e:single-phase": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "mutate": "node scripts/mutate.ts",
    "gen:commands": "node scripts/gen-commands.ts",
    "gen:docs": "node scripts/gen-doc-examples.ts",
    "verify:citations": "node scripts/verify-citations.ts",
    "check:test-glob": "node scripts/check-test-glob.ts",
    "check:retired": "node scripts/check-retired.ts",
    "check:text-files": "node scripts/check-text-files.ts",
    "check:needs-cycles": "node scripts/check-needs-cycles.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
