node_modules/
dist/

# Linked worktrees live here. Without this, `git add -A` on the main checkout
# would commit entire worktree trees into the repository.
.claude/worktrees/

# Subagent-driven-development scratch: ledgers, briefs, review packages
.superpowers/

# editor backup artifacts
*.saved.bak
~*

# Playwright run artefacts: traces, screenshots, the HTML report.
test-results/
playwright-report/
blob-report/

# Built by scripts/demo-corpus.ts — build products, never committed.
#
# `.demo-pack` and `.demo-pack-author` are the pack round trip: the fixture
# needs a pack written by SOMEBODY ELSE, so a throwaway corpus is built, exported
# as a pack, and imported. Both land beside `.demo-corpus` rather than inside it,
# because a pack the corpus contains is a pack the corpus already has — measured,
# that round trip reports `0 new, 0 changed, 4 identical` and the screen draws a
# pack that carried nothing.
.demo-corpus/
.demo-pack/
.demo-pack-author/

# harness scratch
.scratch/

# Playwright MCP session artefacts.
.playwright-mcp/
